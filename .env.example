# Bookshelf — variables de la pile Docker (docker-compose.yml, docker-compose.dev.yml).
# Copier en `.env` à la racine : Docker Compose lit ce fichier (et lui seul) tout seul.
#   cp .env.example .env
# (Développement SANS Docker : voir backend/.env.example.)
#
# Valeurs ci-dessous : déploiement sur un VPS, derrière Caddy, accès par l'IP
# publique en HTTP (sans nom de domaine). Guide : docs/DEPLOY-VPS.md.

# ---- Accès --------------------------------------------------------------------------
# Port LOCAL du front, lié à 127.0.0.1 uniquement : seul Caddy (sur l'hôte) y accède.
PORT=8082
# Adresse publique de l'app, telle que tapée dans le navigateur (celle servie par
# Caddy). Sert d'origine autorisée pour l'API (CORS). Exemples :
#   http://203.0.113.10:8080   (port dédié dans Caddy)
#   http://203.0.113.10        (IP nue, port 80)
APP_URL=http://YOUR_VPS_IP:8080

# ---- PostgreSQL -----------------------------------------------------------------------
POSTGRES_USER=bookshelf
# OBLIGATOIRE. Caractères sûrs pour une URL (lettres, chiffres, - _ .) :
#   openssl rand -base64 24 | tr -d '/+=' | cut -c1-24
POSTGRES_PASSWORD=
POSTGRES_DB=bookshelf
# L'API reçoit : postgresql://USER:PASSWORD@postgres:5432/DB?schema=public
# (assemblée par docker-compose.yml, rien à écrire ici).

# ---- Sécurité -------------------------------------------------------------------------
# OBLIGATOIRE, 32 caractères minimum :
#   openssl rand -base64 48 | tr -d '/+=\n'
JWT_SECRET=

# Cookie de session réservé à HTTPS. `false` tant que l'app est servie en HTTP
# (IP sans certificat) : un cookie `Secure` n'y serait jamais renvoyé par le
# navigateur, et la connexion au compte échouerait. Passer à `true` le jour où
# un nom de domaine avec HTTPS est branché.
COOKIE_SECURE=false

# Proxys de confiance devant l'API (Express `trust proxy`). Chaîne :
#   navigateur → Caddy (hôte) → Nginx (conteneur front) → API
# `2` = exactement ces deux sauts (recommandé). `true` fonctionne aussi (Caddy
# ignore les X-Forwarded-For envoyés par les clients), mais `2` reste juste
# même si un autre proxy s'intercale. Une mauvaise valeur donne à tous les
# visiteurs l'IP du proxy : le limiteur de connexion (par IP) les bloque ensemble.
TRUST_PROXY=2

# Origines autorisées à appeler l'API avec cookies. Par défaut : APP_URL. Le front
# passe par le relais /api (même origine) : utile seulement s'il est servi ailleurs.
# CORS_ORIGINS=http://YOUR_VPS_IP:8080

# ---- API et catalogue -------------------------------------------------------------------
# Préfixe public de l'API (URLs des couvertures). Absolu si l'API est ailleurs.
PUBLIC_API_BASE=/api
# URL de l'API vue par le navigateur, figée dans le build du front. `/api` =
# même origine, relayée par Nginx (recommandé).
VITE_API_URL=/api
# Indexation du catalogue AniList + MangaDex en tâche de fond (quelques minutes
# au premier démarrage, puis une fois par jour). `off` pour la couper.
CATALOG_SYNC=on
# MangaDex exige un User-Agent identifiable.
MANGADEX_USER_AGENT=Bookshelf/0.1 (projet perso)

# ---- E-mails : code de vérification à l'inscription -------------------------------------
# OBLIGATOIRE en production : sans SMTP_HOST, les inscriptions sont refusées
# (aucun compte sans adresse vérifiée). N'importe quel serveur SMTP convient :
# Brevo, Mailjet, Resend, OVH, Gmail (mot de passe d'application)…
SMTP_HOST=
# 587 = STARTTLS (le plus courant) ; 465 = TLS direct (SMTP_SECURE=true).
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Expéditeur affiché. Son domaine doit être autorisé chez le fournisseur SMTP
# (sinon l'e-mail part en indésirables, ou est refusé).
MAIL_FROM=Bookshelf <no-reply@exemple.fr>

# ---- Développement (docker-compose.dev.yml) -------------------------------------------
# Ports de l'hôte : front Vite, API, PostgreSQL (pour un client SQL ou Prisma Studio).
DEV_WEB_PORT=5173
DEV_API_PORT=5000
DEV_DB_PORT=5432

# ---- Caddy dans UNE AUTRE pile Docker (ex. VPS partagé) --------------------------------
# Le front rejoint le réseau de ce Caddy sous le nom `bookshelf-frontend`
# (docker-compose.caddy.yml). Décommenter les deux lignes ; ensuite toutes les
# commandes `docker compose …` incluent ce fichier automatiquement.
# COMPOSE_FILE=docker-compose.yml:docker-compose.caddy.yml
# CADDY_NETWORK=myplaylog_myplaylog
