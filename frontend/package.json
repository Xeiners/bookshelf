{
  "name": "@bookshelf/frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "screenshots": "node scripts/screenshots.mjs",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "test": "npm run i18n:audit && npm run test:unit",
    "test:unit": "node --import tsx --test --test-reporter=spec test/*.test.ts"
  },
  "dependencies": {
    "@fontsource/opendyslexic": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "epubjs": "^0.3.93",
    "fflate": "^0.8.3",
    "gsap": "^3.15.0",
    "lucide-react": "^1.31.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
