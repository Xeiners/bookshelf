# Copier en `.env`. Toutes les valeurs ont un défaut raisonnable en développement.

PORT=5000
NODE_ENV=development

# Chemin relatif au dossier backend/.
DATABASE_URL="file:./prisma/dev.db"

# OBLIGATOIRE en production (32 caractères minimum). Générer par exemple avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Origines autorisées à appeler l'API avec cookies, séparées par des virgules.
# Inutile en dev : le front passe par le proxy Vite (même origine).
CORS_ORIGINS=http://localhost:5173

# Préfixe public de l'API, utilisé pour construire les URLs de couverture.
# À passer en absolu (ex. https://api.exemple.fr/api) si le front est servi ailleurs.
PUBLIC_API_BASE=/api

# MangaDex exige un User-Agent identifiable (pas d'usurpation de navigateur).
MANGADEX_USER_AGENT="Bookshelf/0.1 (projet perso)"

# Proxys de confiance devant l'API (Express `trust proxy`). `loopback` en local ;
# `1` derrière un proxy (le Nginx du conteneur front, cf. docs/DOCKER.md).
TRUST_PROXY=loopback

# Cookie de session réservé à HTTPS. Par défaut : activé en production seulement.
# COOKIE_SECURE=true

# Base : `file:…` → SQLite (défaut, rien à installer) ; `postgresql://…` → PostgreSQL
# (schéma et migrations de prisma/postgres/, cf. docs/DOCKER.md §3).

# E-mails (code de vérification à l'inscription). Sans SMTP_HOST en développement,
# le code s'affiche dans le terminal de l'API ; en production, SMTP est obligatoire.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Bookshelf <no-reply@exemple.fr>"

# Recette : boosters de cartes illimités (taux de tirage, animations). Jamais en production.
# BOOSTER_UNLIMITED_MODE=true

# Indexation du catalogue MangaDex en tâche de fond (`off` pour la couper).
# CATALOG_SYNC=on

# Sources de chapitres supplémentaires (cf. docs/BACKEND.md §3 ter). Chacune reste
# inactive tant que son URL est vide : MangaDex seul par défaut.
# Instance auto-hébergée de l'API Consumet, un catalogue, une langue :
# CONSUMET_API_URL=http://consumet:3000
# CONSUMET_PROVIDER=mangadex
# CONSUMET_LANGUAGE=en
# Bibliothèque personnelle : Komga, Kavita, ou API JSON au contrat « OpenComicStream ».
# L'adresse peut être privée (réseau Docker, LAN) : les images sont téléchargées
# par l'API elle-même, depuis cette seule origine, et jamais exposées au navigateur.
# OPEN_COMIC_API_URL=http://komga:25600
# OPEN_COMIC_KIND=komga            # opencomic (défaut) | komga | kavita
# OPEN_COMIC_API_KEY=              # Komga : Compte → Clés d'API ; Kavita : Profil → API Key
# OPEN_COMIC_USER=                 # Komga sans clé d'API : compte (authentification Basic)
# OPEN_COMIC_PASSWORD=
# OPEN_COMIC_LANGUAGE=fr           # langue des œuvres si la bibliothèque ne la précise pas
# OPEN_COMIC_NAME="Ma bibliothèque" # badge de provenance (défaut : Komga / Kavita / Open Comic)
# Extensions Tachiyomi / Mihon via le pont Suwayomi. En local, le démarrer avec
#   docker compose -f docker-compose.dev.yml --profile tachiyomi up -d suwayomi
# puis gérer les extensions : npm run tachiyomi -w backend -- extensions fr en
# TACHIYOMI_BRIDGE_ENABLED=true
# TACHIYOMI_BRIDGE_URL=http://localhost:4567
# TACHIYOMI_BRIDGE_TIMEOUT_MS=3000   # délai d'un appel au pont : un site plus lent est abandonné
# TACHIYOMI_EXTENSIONS=en.asurascans,fr.mangascantrad   # installées au démarrage
# TACHIYOMI_BRIDGE_LANGUAGES=fr,en
# TACHIYOMI_BRIDGE_MAX_SOURCES=10
# TACHIYOMI_SOURCES=               # ne garder que ces sites (noms ou identifiants)
# TACHIYOMI_BRIDGE_NSFW=false

# ---- Romans EPUB (cf. src/modules/books/) ----------------------------------------------
# BOOKS_DIR=uploads/books           # dossier des fichiers, relatif à backend/ (ou absolu)
# BOOKS_MAX_UPLOAD_MB=50            # taille max d'un EPUB importé
# BOOKS_QUOTA_MB=2048               # espace par compte
# BOOKS_METADATA_LOOKUP=on          # fiches Open Library + Google Books (off : aucun appel sortant)
# GOOGLE_BOOKS_API_KEY=             # facultative : sans clé, Google renvoie souvent 429
