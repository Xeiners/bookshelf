# Copier en `.env`. Toutes les valeurs ont un défaut raisonnable en développement.

PORT=5000
NODE_ENV=development

# Chemin relatif au dossier backend/.
DATABASE_URL="file:./prisma/dev.db"

# OBLIGATOIRE en production (32 caractères minimum). Générer par exemple avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Origines autorisées à appeler l'API avec cookies, séparées par des virgules.
# Inutile en dev : le front passe par le proxy Vite (même origine).
CORS_ORIGINS=http://localhost:5173

# Préfixe public de l'API, utilisé pour construire les URLs de couverture.
# À passer en absolu (ex. https://api.exemple.fr/api) si le front est servi ailleurs.
PUBLIC_API_BASE=/api

# MangaDex exige un User-Agent identifiable (pas d'usurpation de navigateur).
MANGADEX_USER_AGENT="Bookshelf/0.1 (projet perso)"

# Proxys de confiance devant l'API (Express `trust proxy`). `loopback` en local ;
# `1` derrière un proxy (le Nginx du conteneur front, cf. docs/DOCKER.md).
TRUST_PROXY=loopback

# Cookie de session réservé à HTTPS. Par défaut : activé en production seulement.
# COOKIE_SECURE=true

# Base : `file:…` → SQLite (défaut, rien à installer) ; `postgresql://…` → PostgreSQL
# (schéma et migrations de prisma/postgres/, cf. docs/DOCKER.md §3).

# Indexation du catalogue AniList + MangaDex en tâche de fond (`off` pour la couper).
# CATALOG_SYNC=on
