// Schéma de la base Bookshelf.
//
// SOURCE UNIQUE des modèles, pour deux bases :
//  - SQLite (ce fichier) : développement local et tests, zéro service à lancer ;
//  - PostgreSQL (Docker, production) : prisma/postgres/schema.prisma, GÉNÉRÉ depuis
//    celui-ci par `npm run db:schema:pg` (seuls le fournisseur et le dossier du
//    client changent), avec ses propres migrations dans prisma/postgres/migrations.
// `DATABASE_URL` choisit la base (cf. prisma.config.ts et src/db.ts). Aucun type
// spécifique à SQLite n'est utilisé.
//
// SQLite ne gère pas les `enum` Prisma : les statuts sont des `String`,
// validés à l'entrée de l'API (cf. `src/modules/library/library.schemas.ts`).

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  /// Toujours stocké en minuscules (normalisé par l'API).
  email        String   @unique
  passwordHash String
  displayName  String?
  /// Profil (cf. `src/modules/users/`) : présentation libre, 160 caractères au plus.
  bio          String?
  /// Carte choisie comme avatar : toujours une carte POSSÉDÉE (vérifié par l'API).
  avatarCardId String?
  /// Couverture d'une œuvre de la bibliothèque. Prioritaire sur `avatarCardId`.
  avatarUrl    String?
  /// Vitrine : JSON `string[]` de 3 ids de cartes possédées au plus, dans l'ordre d'affichage.
  featuredCardIds String @default("[]")
  /// Titre affiché sous le pseudo : un id de `TITLES`, débloqué par les statistiques.
  activeTitle  String?
  /// Boosters ouverts depuis la création du compte (boosters d'essai compris).
  boostersOpened Int     @default(0)
  /// Profil public (cf. `publicProfile.service.ts`) : présentation, statistiques et lectures visibles
  /// par tous. Privé : seuls le pseudo, l'avatar, le titre et la vitrine restent visibles.
  isProfilePublic Boolean @default(true)
  /// Langue de l'interface et du catalogue : 'fr' | 'en' (validée par l'API).
  preferredLanguage String @default("fr")
  /// Oracle : dernier jour de tirage (YYYY-MM-DD, calendrier local de l'utilisateur).
  oracleLastDay String?
  /// Jours de tirage d'affilée, et record.
  oracleStreak  Int      @default(0)
  oracleBest    Int      @default(0)
  /// Adresse confirmée par le code envoyé à l'inscription. `null` : comptes
  /// créés avant la vérification par e-mail.
  emailVerifiedAt DateTime?
  /// Suspendu par un administrateur (cf. `src/modules/admin/`) : connexion refusée, sessions coupées.
  suspendedAt     DateTime?
  /// Motif de la suspension, montré au titulaire à la connexion.
  suspendedReason String?
  /// Version des sessions : l'incrémenter invalide tous les jetons déjà émis (suspension).
  sessionVersion  Int       @default(0)
  /// Dernière requête authentifiée (à quelques minutes près) : pour l'administration.
  lastSeenAt      DateTime?
  /// Poussières d'Étoile (cf. `src/modules/stardust/`) : gagnées au BookshelfDLE, dépensées en boosters.
  /// Jamais négatif ; chaque mouvement est inscrit dans `StardustEntry`.
  stardust        Int       @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  entries    LibraryEntry[]
  skips      SkippedWork[]
  preference UserPreference?
  booster    UserBooster?
  cards      UserCard[]
  books      UserBook[]
  musicPlaylists MusicPlaylist[]
  tradeOffers    TradeOffer[] @relation("TradeOwner")
  tradesAccepted TradeOffer[] @relation("TradeResponder")
  notifications  Notification[]
  stardustEntries StardustEntry[]
  dleDailies     DleDaily[]
  dleStats       DleStats?
}

/// Une œuvre dans la bibliothèque d'un utilisateur.
/// La clé composite (userId, workId) rend les doublons impossibles par construction.
model LibraryEntry {
  userId    String
  /// Id de la source : UUID MangaDex, ou id Open Library pour les anciennes données.
  workId    String
  /// 'wishlist' | 'reading' | 'read'
  status    String
  /// Avancement 0 → 1.
  progress  Float    @default(0)
  /// Chapitres lus dans le lecteur intégré : ne fait que croître, d'un appareil à l'autre.
  chaptersRead Int   @default(0)
  /// Position de lecture, JSON `ReadingPosition` (cf. `library.schemas.ts`).
  /// `null` : jamais ouvert dans le lecteur.
  position  String?
  /// Coup de cœur de l'utilisateur.
  favorite   Boolean @default(false)
  /// Note personnelle, 0,5 → 5 par demi-étoiles (titres lus). `null` = pas notée.
  userRating Float?
  /// Instantané JSON du modèle `Book` du front : la bibliothèque s'affiche sans
  /// rappeler MangaDex, y compris sur un autre appareil.
  ///
  /// Volontairement par utilisateur et non dans une table `Work` partagée :
  /// l'instantané vient du client, un utilisateur ne doit pas pouvoir modifier
  /// la fiche vue par un autre.
  snapshot  String
  title     String
  addedAt   DateTime @default(now())
  /// Horodatage de la dernière modification côté client : arbitre les fusions.
  updatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, workId])
  @@index([userId, status])
}

/// Swipe gauche : l'œuvre ne sera plus proposée. Sans fiche : un id suffit.
model SkippedWork {
  userId    String
  workId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, workId])
}

/// Profil de goûts d'un compte, mis à jour à chaque swipe (cf. `src/services/recommendation/`).
model UserPreference {
  userId    String   @id
  /// JSON `{ genres: { Action: 12, … }, tags: { Revenge: 8, … } }`.
  scores    String   @default("{\"genres\":{},\"tags\":{}}")
  /// Nombre de swipes pris en compte : mesure la confiance du profil.
  swipes    Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Catalogue MangaDex en cache local : le deck, la recherche et l'Oracle s'y
/// servent sans aucun appel réseau. Une ligne par œuvre MangaDex.
model CatalogWork {
  mangadexId String   @id
  /// Pays d'origine, d'après la langue originale : JP (manga), KR (manhwa), CN (manhua).
  country    String
  /// Note bayésienne MangaDex (/10), quand elle est connue.
  rating     Float?
  /// Lecteurs qui suivent l'œuvre sur MangaDex.
  popularity Int      @default(0)
  /// JSON `string[]` : tags MangaDex du groupe « genre » (noms anglais).
  genres     String
  /// JSON `{ name, rank }[]` : tags MangaDex du groupe « theme » (noms anglais).
  tags       String
  /// JSON : œuvre MangaDex brute (titres, résumés, couverture, auteurs).
  mangadex   String
  /// Statut de parution MangaDex (ongoing, completed, hiatus, cancelled),
  /// dernier chapitre et année : filtres de la recherche et « rythme » de
  /// l'Oracle, sans relire la fiche JSON.
  status     String?
  chapters   Int?
  year       Int?
  /// Titres (toutes langues) et auteurs, en minuscules sans accents : recherche plein texte.
  searchText String   @default("")
  updatedAt  DateTime @updatedAt

  @@index([country, popularity])
}

/// Stock de boosters d'un compte (cf. `src/modules/cards/`). La régénération
/// est calculée à la lecture à partir de `nextBoosterAt` : aucune tâche de fond.
model UserBooster {
  userId            String    @id
  /// Boosters prêts à ouvrir, 2 au plus.
  availableBoosters Int       @default(2)
  /// Boosters offerts par un administrateur : hors plafond, jamais perdus, ouverts après le stock normal.
  giftedBoosters    Int       @default(0)
  /// Boosters consécutifs sans Mythique ; le 30e force le dernier slot.
  boostersSinceLastMythic Int  @default(0)
  /// Dernière ouverture.
  lastClaimedAt     DateTime?
  /// Arrivée du prochain booster ; `null` quand le stock est plein.
  nextBoosterAt     DateTime?
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Carte de la collection : une œuvre du catalogue MangaDex. Le set est figé à
/// sa génération (les cartes obtenues ne doivent jamais disparaître).
model Card {
  id            String   @id @default(cuid())
  /// Numéro dans l'album (1 → taille du set), ordre d'affichage.
  number        Int      @unique
  /// Série éditoriale : 1 pour les cartes historiques, 2 pour l'extension.
  series        Int      @default(1)
  /// Nom affiché de la carte et titre canonique de l'œuvre.
  name          String   @default("")
  mangaTitle    String   @default("")
  title         String
  /// Personnage représenté ; `null` : la carte représente l'œuvre.
  characterName String?
  description   String   @default("")
  /// Valeur de collection dérivée de la rareté et du prestige de l'œuvre.
  power         Int      @default(0)
  /// Couverture, servie par le relais `/api/covers`.
  imageUrl      String
  /// COMMON | RARE | EPIC | LEGENDARY | MYTHIC
  rarity        String
  /// UUID MangaDex de l'œuvre.
  mangaId       String   @unique
  createdAt     DateTime @default(now())

  owners UserCard[]
  offeredIn   TradeOffer[] @relation("TradeOffered")
  requestedIn TradeOffer[] @relation("TradeRequested")

  @@index([rarity])
  @@index([series, rarity])
}

/// Carte possédée par un compte ; `count` compte les doublons.
model UserCard {
  userId     String
  cardId     String
  obtainedAt DateTime @default(now())
  isFavorite Boolean  @default(false)
  count      Int      @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([userId, cardId])
}

/// Roman importé par un compte (EPUB) : le fichier vit sur le serveur (cf.
/// `src/modules/books/`), la position de lecture suit le compte d'un appareil à l'autre.
model UserBook {
  id              String    @id @default(cuid())
  userId          String
  title           String
  author          String?
  /// Couverture choisie hors du fichier (Open Library, Google Books). `null` :
  /// celle du fichier (`coverPath`), sinon une couverture procédurale.
  coverUrl        String?
  /// Chemins RELATIFS au dossier des livres (`BOOKS_DIR`), jamais tirés d'une
  /// saisie : `<userId>/<sha256>.epub`, et la couverture extraite du fichier.
  filePath        String
  coverPath       String?
  /// Octets du fichier (50 Mo au plus).
  fileSize        Int
  /// Empreinte SHA-256 du fichier : le même EPUB importé deux fois n'est stocké qu'une fois.
  sha256          String
  /// 'EPUB' : seul format accepté pour l'instant.
  format          String    @default("EPUB")
  /// Nom du fichier chez l'utilisateur, pour l'affichage.
  originalName    String
  synopsis        String    @default("")
  /// Code de langue du livre ('fr', 'en'…), lu dans le fichier.
  language        String?
  publisher       String?
  year            Int?
  /// Pagination de l'édition papier, quand les métadonnées en ligne la connaissent.
  pages           Int?
  /// Avancement 0 → 100.
  progressPercent Float     @default(0)
  /// Position EPUB (CFI) : la phrase exacte où la lecture s'est arrêtée.
  lastCfi         String?
  /// Horodatage CLIENT de cette position : entre deux appareils, la plus récente gagne.
  progressAt      DateTime?
  /// Fiche de la bibliothèque à laquelle ce fichier est rattaché (`LibraryEntry.workId`) : roman
  /// en ligne (`ol:OL…W`, `gb:…`) ou fiche tirée du fichier lui-même (`novel:<id>`).
  /// `null` : pas encore rattaché (choix en attente, ou import d'avant le rattachement).
  workId          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sha256])
  /// Un fichier par fiche : « Lire » ouvre toujours le même.
  @@unique([userId, workId])
  @@index([userId, updatedAt])
}

/// Fin de la dernière indexation COMPLÈTE du catalogue : une indexation
/// interrompue (redémarrage, source injoignable) n'est jamais prise pour fraîche.
model CatalogSync {
  id          String   @id
  completedAt DateTime
}

/// Inscription en attente de son code de vérification. Le compte (`User`) n'est
/// créé qu'une fois le code saisi : sans code, pas de compte. Expire seule.
model PendingRegistration {
  /// Toujours en minuscules (normalisé par l'API).
  email             String   @id
  passwordHash      String
  displayName       String?
  preferredLanguage String   @default("fr")
  /// HMAC-SHA256 du code (jamais le code en clair).
  codeHash          String
  expiresAt         DateTime
  /// Codes faux saisis pour le code courant.
  attempts          Int      @default(0)
  /// Codes envoyés pour cette inscription (plafonnés).
  sends             Int      @default(1)
  lastSentAt        DateTime @default(now())
  createdAt         DateTime @default(now())

  @@index([expiresAt])
}

/// Playlist de musique d'ambiance d'un compte, synchronisée entre ses appareils
/// (cf. `src/modules/music/playlists.ts`). L'identifiant vient de l'appareil qui
/// l'a créée : unique par compte seulement. Fusion morceau par morceau impossible
/// sans historique : la version la plus récente (`updatedAt`) d'une playlist gagne.
model MusicPlaylist {
  userId    String
  id        String
  name      String
  /// JSON `{ id, kind, ref, title }[]` : vidéos (ou playlists YouTube) dans l'ordre choisi.
  tracks    String   @default("[]")
  createdAt DateTime
  /// Horodatage CLIENT de la dernière modification : arbitre les fusions entre appareils.
  updatedAt DateTime
  /// Supprimée : gardée (sans morceaux) pour que la suppression atteigne les autres appareils.
  deleted   Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, id])
}

/// Offre d'échange de cartes (cf. `src/modules/trades/`) : un doublon proposé
/// contre une carte de même rareté. Tant que l'offre est ouverte, son exemplaire
/// est réservé : le créateur garde toujours au moins un exemplaire de la carte.
model TradeOffer {
  id              String   @id @default(cuid())
  /// Créateur de l'offre.
  userId          String
  /// Doublon proposé.
  offeredCardId   String
  /// Carte demandée en échange (même rareté).
  requestedCardId String
  /// 'OPEN' | 'COMPLETED' | 'CANCELLED' (validé par l'API).
  status          String   @default("OPEN")
  /// Compte qui a accepté l'échange (offre `COMPLETED`).
  acceptedById    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User  @relation("TradeOwner", fields: [userId], references: [id], onDelete: Cascade)
  acceptedBy    User? @relation("TradeResponder", fields: [acceptedById], references: [id], onDelete: SetNull)
  offeredCard   Card  @relation("TradeOffered", fields: [offeredCardId], references: [id], onDelete: Cascade)
  requestedCard Card  @relation("TradeRequested", fields: [requestedCardId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, status])
  @@index([acceptedById])
}

/// Notification d'un compte (cf. `src/modules/notifications/`) : un échange conclu, une offre du
/// marché qui l'intéresse… Le texte est rédigé par le front, dans sa langue, depuis `type` et `data`.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  /// 'trade_accepted' | 'trade_match' (validé par l'API).
  type      String
  /// JSON propre au type : cartes concernées (instantanés), offre, autre collectionneur.
  data      String    @default("{}")
  /// `null` : pas encore lue.
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/// Journal de l'administration (cf. `src/modules/admin/`) : qui a fait quoi, à qui. Sans clé étrangère :
/// le journal survit à la suppression des comptes qu'il cite.
model AdminAction {
  id           String   @id @default(cuid())
  adminId      String
  /// E-mail de l'administrateur au moment de l'action (lisible même si le compte disparaît).
  adminEmail   String
  /// Compte visé, s'il y en a un.
  targetUserId String?
  /// 'gift_boosters' | 'gift_card' | 'suspend' | 'unsuspend' | 'moderate'
  action       String
  /// JSON propre à l'action (nombre, carte, motif, champs modérés…).
  details      String   @default("{}")
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([targetUserId, createdAt])
}

/// Mouvement de Poussières d'Étoile (cf. `src/modules/stardust/`) : gain (+) ou dépense (−).
/// Sert d'historique, et de compteur pour les plafonds quotidiens des gains.
model StardustEntry {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  /// 'dle_daily' | 'dle_room' | 'booster_purchase'
  reason    String
  /// JSON propre au motif (jour et mode, salon et rang…).
  data      String   @default("{}")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, reason, createdAt])
}

/// Énigme du jour du BookshelfDLE (cf. `src/modules/dle/`) : la même pour tout le monde, fixée au
/// premier joueur du jour (un set de cartes qui grandit ne la change pas en cours de journée).
model DlePuzzle {
  /// Jour de l'énigme, `YYYY-MM-DD`, heure de Paris.
  day       String
  /// 'manga' | 'naruto'
  category  String   @default("manga")
  /// 'classic' | 'zoom'
  mode      String
  /// Ce qu'il faut deviner : id de carte (manga) ou de personnage (naruto).
  cardId    String
  createdAt DateTime @default(now())

  @@id([day, category, mode])
}

/// Partie d'un compte sur l'énigme du jour : ses essais, sa victoire, ses gains.
model DleDaily {
  userId    String
  day       String
  category  String    @default("manga")
  mode      String
  /// JSON `string[]` : ids des cartes proposées, dans l'ordre.
  guesses   String    @default("[]")
  solvedAt  DateTime?
  /// Poussières gagnées (0 tant que l'énigme n'est pas résolue).
  reward    Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day, category, mode])
}

/// Palmarès BookshelfDLE d'un compte.
model DleStats {
  userId       String  @id
  /// Jours d'affilée avec au moins une énigme du jour résolue, et record.
  dailyStreak  Int     @default(0)
  dailyBest    Int     @default(0)
  dailyLastDay String?
  dailySolved  Int     @default(0)
  /// Parties multijoueur terminées (au moins deux joueurs), et gagnées.
  roomsPlayed  Int     @default(0)
  roomsWon     Int     @default(0)
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
